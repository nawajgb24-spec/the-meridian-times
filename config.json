{
  "project": {
    "name": "The Meridian Times",
    "version": "1.1.0",
    "environment": "production"
  },

  "github": {
    "branch": "main"
  },

  "website": {
    "url": "https://themeridiantimes.com",
    "language": "en",
    "homepage_limit": 30
  },

  "publishing": {
    "articles_per_run": 1,
    "max_articles": 500,
    "schedule_hours": 2,
    "regeneration_attempts": 1,
    "retry_failed_topics": true
  },

  "content": {
    "min_words": 900,
    "max_words": 1300,
    "summary_sentences": 2,
    "duplicate_similarity": 85,
    "min_tags": 5,
    "target_reading_time": 5
  },

  "homepage": {
    "hot_news_limit": 10,
    "trending_limit": 30
  },

  "categories": [
    "World",
    "Trending News",
    "Business",
    "Stock News",
    "Tech",
    "Sports",
    "Lifestyle",
    "Anime",
    "Food & Nutrition"
  ]
}
